{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:debug"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolKnit Desktop",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "devtools": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI --use-fake-ui-for-media-stream --remote-debugging-port=9223 --remote-allow-origins=http://127.0.0.1:9223",
        "dragDropEnabled": true
      }
    ]
  }
}
